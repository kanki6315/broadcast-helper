{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "frontend",
      "port": 6731,
      "autoPort": false
    },
    {
      "name": "backend",
      "runtimeExecutable": "./gradlew",
      "runtimeArgs": ["bootRun"],
      "cwd": "backend",
      "port": 8731
    },
    {
      "name": "frontend-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "preview"],
      "cwd": "frontend",
      "port": 6732,
      "autoPort": false
    },
    {
      "name": "backend-spare",
      "runtimeExecutable": "./gradlew",
      "runtimeArgs": ["bootRun", "--args=--server.port=8790"],
      "cwd": "backend",
      "port": 8790,
      "autoPort": false
    },
    {
      "name": "frontend-spare",
      "runtimeExecutable": "env",
      "runtimeArgs": ["VITE_API_ORIGIN=http://localhost:8790", "npm", "run", "dev", "--", "--port", "6790"],
      "cwd": "frontend",
      "port": 6790,
      "autoPort": false
    },
    {
      "name": "backend-spare2",
      "runtimeExecutable": "./gradlew",
      "runtimeArgs": ["bootRun", "--args=--server.port=8791"],
      "cwd": "backend",
      "port": 8791,
      "autoPort": false
    },
    {
      "name": "frontend-spare2",
      "runtimeExecutable": "env",
      "runtimeArgs": ["VITE_API_ORIGIN=http://localhost:8791", "npm", "run", "dev", "--", "--port", "6791"],
      "cwd": "frontend",
      "port": 6791,
      "autoPort": false
    }
  ]
}
