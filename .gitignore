.DS_Store
*.iml
.idea/
.vscode/
.env

# Machine-local Spring config — holds real iRacing credentials, loaded by the
# `local` profile (bootRun only). Must never be committed; the server builds from
# git, so its absence there is what keeps the secret out of the jar.
application-local.yml
application-local.yaml

# Python
__pycache__/
*.pyc
.venv/
build/
*.egg-info/

# Impeccable design-hook cache
.impeccable/

# iOS app: the Xcode project is generated from ios/project.yml (xcodegen).
ios/*.xcodeproj
ios/build/
ios/DerivedData/
xcuserdata/
ios/build-tests/
